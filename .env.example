# ==============================================================================
# Trao AI Interview Prep Kit - Environment Variables
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/trao_interview_prep

# Authentication (JWT Secret - minimum 32 characters for security)
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# Frontend URL (For CORS configuration on Express backend)
CLIENT_URL=http://localhost:3000

# Backend URL (For Next.js frontend API calls)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# LLM Provider Configuration (Genuine Free Tier)
# Supported options: 'gemini' | 'groq' | 'openai'
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash
LLM_MAX_RETRIES=3
LLM_TIMEOUT_MS=30000

# Research / Public Discussion Search Provider
# Supported options: 'duckduckgo' | 'tavily' | 'serper'
# Note: 'duckduckgo' works without an API key using public search extraction.
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# Security & Crawler Settings
# Set to 'true' only when executing batch evaluation on local fixture servers (e.g. http://localhost:8099/)
ALLOW_LOCAL_CRAWL=false

# Batch CLI Concurrency (Number of cases processed concurrently)
BATCH_CONCURRENCY=2
